generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OPERATOR
  MASTER
}

enum ProcessStatus {
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  AGUARDANDO_OPERADOR
  CORRECAO_SOLICITADA
  CONCLUIDO
  CANCELADO
}

enum StepKey {
  ETAPA_1
  ETAPA_2
  ETAPA_3
  ETAPA_4
  ETAPA_5
  ETAPA_6
}

enum KanbanStage {
  VIABILIDADE
  DOC_INICIAL_APROVADA
  DBE_RECEITA_FEDERAL
  PREPARACAO_DOCUMENTOS
  AGUARDANDO_DOCUMENTOS
  ANALISE_JUCEB
  EXIGENCIA_JUCEB
  FINALIZADO
}

enum AlteracaoContratualStage {
  VIABILIDADE
  DOC_INICIAL_APROVADA
  DBE_RECEITA_FEDERAL
  PREPARACAO_DOCUMENTOS
  AGUARDANDO_DOCUMENTOS
  ANALISE_JUCEB
  EXIGENCIA_JUCEB
  FINALIZADO
  // Legacy values remain readable for rows created by the first preview.
  SOLICITACAO_RECEBIDA
  ANALISE_JURIDICA
  AJUSTES_DOCUMENTAIS
  PROTOCOLO
}

enum StepSide {
  CLIENTE
  OPERADOR
}

enum DocumentItemKey {
  IDENTIFICACAO_SOCIOS
  COMPROVANTE_RESIDENCIA
  FOTO_FACHADA
}

enum DocumentItemStatus {
  PENDENTE
  AGUARDANDO_VALIDACAO
  APROVADO
  REPROVADO
}

enum AuditActorRole {
  CLIENTE
  OPERADOR
  MASTER
  SYSTEM
}

enum ChatAuthorRole {
  CLIENTE
  OPERADOR
  BOT
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum SlaStatus {
  ON_TRACK
  AT_RISK
  OVERDUE
  STOPPED
}

enum IdempotencyScope {
  PROCESS_CREATE
  CUSTOMER_LINK_REQUEST
  COMPLETED_PROCESS_FINALIZATION
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  whatsapp     String?
  role         Role
  tenantKey    String   @default("default")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProcesses Process[]          @relation("ProcessOwner")
  sessions       Session[]
  notifications  UserNotification[]
}

model Process {
  id                 String          @id @default(uuid())
  clientName         String?
  companyKey         String?
  clientEmail        String
  clientPhone        String?
  legacyClientId     String?
  finalizedAt        DateTime?
  tenantKey          String          @default("default")
  status             ProcessStatus   @default(EM_ANDAMENTO)
  currentStep        StepKey         @default(ETAPA_1)
  kanbanStage        KanbanStage     @default(VIABILIDADE)
  ownerId            String?
  owner              User?           @relation("ProcessOwner", fields: [ownerId], references: [id])
  cancelledAt        DateTime?
  cancelledByRole    AuditActorRole?
  cancelledById      String?
  cancelReason       String?
  operatorStatusNote String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  steps                 ProcessStep[]
  checklists            Checklist[]
  documents             DocumentItem[]
  chats                 ChatThread[]
  ownerHistory          ProcessOwnerHistory[]
  slaEvents             SlaEvent[]
  reports               Report[]
  notifications         UserNotification[]
  fileObjects           FileObject[]
  alteracoesContratuais AlteracaoContratual[]
  contracts             Contract[]
  finalization          ProcessFinalization?
  legacyClient          LegacyClient?       @relation(fields: [legacyClientId], references: [id])

  @@index([ownerId, createdAt])
  @@index([kanbanStage, ownerId, createdAt])
  @@index([clientEmail, createdAt])
  @@index([companyKey, createdAt])
  @@index([clientPhone, createdAt])
  @@index([status, createdAt])
  @@index([tenantKey, status, finalizedAt])
}

model LegacyClient {
  id               String   @id @default(uuid())
  kind             String
  name             String
  tradeName        String?
  documentNumber   String
  normalizedDocument String
  tenantKey          String   @default("default")
  address          String?
  city             String?
  state            String?
  municipalRegistration String?
  stateRegistration String?
  phone            String?
  email            String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  processes        Process[]
  contracts        Contract[]

  @@index([name])
  @@index([createdAt])
  @@unique([tenantKey, normalizedDocument])
}

model ProcessFinalization {
  id          String   @id @default(uuid())
  processId   String   @unique
  finalizedAt DateTime @default(now())
  finalizedById String?
  previousStatus ProcessStatus?
  createdAt   DateTime @default(now())
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  @@index([finalizedAt])
}

model Contract {
  id             String   @id @default(uuid())
  processId      String?
  alteracaoId    String?
  legacyClientId String?
  tenantKey      String   @default("default")
  title          String
  type           String?
  description    String?
  status         String   @default("RASCUNHO")
  origin         String
  editorSchemaVersion String @default("1")
  currentVersion Int      @default(1)
  conversionStatus String @default("CONCLUIDO")
  conversionMessage String?
  conversionMetadata Json?
  usedOcr        Boolean @default(false)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  process        Process? @relation(fields: [processId], references: [id], onDelete: Cascade)
  alteracao      AlteracaoContratual? @relation(fields: [alteracaoId], references: [id], onDelete: SetNull)
  legacyClient   LegacyClient? @relation(fields: [legacyClientId], references: [id])
  versions       ContractVersion[]
  files          ContractFile[]
  exports        ContractExport[]
  conversions    ContractConversion[]
  @@index([processId, updatedAt])
  @@index([alteracaoId, updatedAt])
  @@index([legacyClientId, updatedAt])
  @@index([tenantKey, updatedAt])
}

model ContractConversion {
  id           String   @id @default(uuid())
  contractId   String
  status       String   @default("CONCLUIDO")
  attempt      Int      @default(1)
  progress     Int      @default(100)
  usedOcr      Boolean  @default(false)
  metadata     Json?
  errorCode    String?
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  @@index([contractId, createdAt])
  @@index([status, createdAt])
}

model ContractVersion {
  id           String   @id @default(uuid())
  contractId   String
  version      Int
  status       String
  content      Json
  source       String
  sha256       String
  createdById  String?
  createdAt    DateTime @default(now())
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  @@unique([contractId, version])
  @@index([contractId, createdAt])
}

model ContractFile {
  id           String   @id @default(uuid())
  contractId   String
  kind         String
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  data         Bytes
  createdById  String?
  createdAt    DateTime @default(now())
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  @@index([contractId, kind, createdAt])
}

model ContractExport {
  id           String   @id @default(uuid())
  contractId   String
  version      Int
  format       String
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  data         Bytes
  createdById  String?
  createdAt    DateTime @default(now())
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  @@unique([contractId, version, format])
  @@index([contractId, createdAt])
}

model AlteracaoContratual {
  id              String                   @id @default(uuid())
  processId       String
  tenantKey       String                   @default("default")
  alterationType  String
  alterationTypes Json?
  stage           AlteracaoContratualStage @default(DOC_INICIAL_APROVADA)
  version         Int                      @default(1)
  requestedByRole AuditActorRole
  requestedById   String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  dueAt           DateTime?
  slaStatus       String                   @default("ON_TRACK")

  process Process                      @relation(fields: [processId], references: [id])
  history AlteracaoContratualHistory[]
  contracts Contract[]

  @@index([processId, alterationType, updatedAt])
  @@index([stage, updatedAt])
  @@index([processId, updatedAt])
}

model AlteracaoContratualHistory {
  id          String                    @id @default(uuid())
  alteracaoId String
  tenantKey   String                    @default("default")
  fromStage   AlteracaoContratualStage?
  toStage     AlteracaoContratualStage
  version     Int
  actorRole   AuditActorRole
  actorId     String?
  comment     String?
  createdAt   DateTime                  @default(now())

  alteracao AlteracaoContratual @relation(fields: [alteracaoId], references: [id], onDelete: Cascade)

  @@unique([alteracaoId, version])
  @@index([alteracaoId, createdAt])
}

model ProcessStep {
  id        String        @id @default(uuid())
  processId String
  stepKey   StepKey
  side      StepSide
  data      Json
  status    ProcessStatus
  locked    Boolean       @default(false)
  updatedAt DateTime      @updatedAt
  createdAt DateTime      @default(now())

  process Process @relation(fields: [processId], references: [id])

  @@unique([processId, stepKey])
}

model Checklist {
  id        String   @id @default(uuid())
  processId String
  stepKey   StepKey
  items     Json
  status    String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  process Process @relation(fields: [processId], references: [id])

  @@unique([processId, stepKey])
}

model DocumentItem {
  id        String             @id @default(uuid())
  processId String
  itemKey   DocumentItemKey
  socioId   String?
  status    DocumentItemStatus @default(PENDENTE)
  version   Int                @default(1)
  reason    String?
  updatedAt DateTime           @updatedAt
  createdAt DateTime           @default(now())

  process Process        @relation(fields: [processId], references: [id])
  files   DocumentFile[]

  @@unique([processId, itemKey, socioId])
}

model DocumentFile {
  id             String         @id @default(uuid())
  itemId         String
  fileName       String
  mimeType       String
  size           Int
  data           Bytes
  createdAt      DateTime       @default(now())
  uploadedByRole AuditActorRole
  uploadedById   String?

  item DocumentItem @relation(fields: [itemId], references: [id])

  @@index([itemId, createdAt])
}

model ChatThread {
  id        String    @id @default(uuid())
  processId String
  createdAt DateTime  @default(now())
  botState  Json?
  handoffAt DateTime?

  process  Process       @relation(fields: [processId], references: [id])
  messages ChatMessage[]

  @@unique([processId])
}

model ChatMessage {
  id         String         @id @default(uuid())
  threadId   String
  authorRole ChatAuthorRole
  authorId   String?
  body       String
  createdAt  DateTime       @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
}

model Session {
  id             String         @id @default(uuid())
  role           AuditActorRole
  userId         String?
  clientEmail    String?
  clientWhatsapp String?
  tokenHash      String         @unique
  expiresAt      DateTime
  lastActiveAt   DateTime
  rotatedAt      DateTime?
  createdAt      DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([expiresAt])
}

model CustomerLinkToken {
  id                String    @id @default(uuid())
  email             String?
  whatsapp          String?
  tokenHash         String    @unique
  tokenExpiresAt    DateTime
  otpHash           String?
  otpExpiresAt      DateTime?
  otpSentCount      Int       @default(0)
  otpFailedAttempts Int       @default(0)
  otpBlockedUntil   DateTime?
  lastOtpSentAt     DateTime?
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([email, usedAt, tokenExpiresAt, createdAt(sort: Desc)])
  @@index([whatsapp, usedAt, tokenExpiresAt, createdAt(sort: Desc)])
}

model ProcessOwnerHistory {
  id         String   @id @default(uuid())
  processId  String
  ownerId    String?
  assignedAt DateTime @default(now())
  assignedBy String?

  process Process @relation(fields: [processId], references: [id])

  @@index([ownerId, assignedAt])
  @@index([processId, assignedAt])
}

model AuditEvent {
  id         String         @id @default(uuid())
  actorRole  AuditActorRole
  actorId    String?
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  metadata   Json
  ip         String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  @@index([createdAt(sort: Desc), entity, action])
}

model SlaConfigStep {
  id            String   @id @default(uuid())
  stepKey       StepKey
  side          StepSide
  durationHours Int
  alertPercent  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([stepKey, side])
}

model SlaEvent {
  id             String    @id @default(uuid())
  processId      String
  stepKey        StepKey
  side           StepSide
  startedAt      DateTime
  dueAt          DateTime
  status         SlaStatus
  lastNotifiedAt DateTime?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  process Process @relation(fields: [processId], references: [id])

  @@unique([processId, stepKey, side])
  @@index([status, dueAt])
}

model Report {
  id        String   @id @default(uuid())
  processId String
  fileName  String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  process Process @relation(fields: [processId], references: [id])

  @@index([processId, createdAt(sort: Desc)])
}

model Notification {
  id        String              @id @default(uuid())
  channel   NotificationChannel
  recipient String
  subject   String
  body      String
  status    String
  createdAt DateTime            @default(now())

  @@index([createdAt(sort: Desc), channel, status])
}

model UserNotification {
  id        String    @id @default(uuid())
  userId    String
  processId String?
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id])
  process Process? @relation(fields: [processId], references: [id])

  @@index([userId, readAt])
}

model IdempotencyKey {
  id          String           @id @default(uuid())
  scope       IdempotencyScope
  key         String
  requestHash String
  response    Json?
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([scope, key])
  @@index([expiresAt])
}

model FileObject {
  id           String   @id @default(uuid())
  processId    String?
  bucket       String
  objectKey    String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploadedAt   DateTime @default(now())

  process Process? @relation(fields: [processId], references: [id])
}
